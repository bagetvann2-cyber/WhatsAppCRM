// Схема базы. Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
}

/// Категории Meta. От категории зависит цена сообщения и строгость модерации.
enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// DRAFT — наш собственный статус, до отправки в Meta. Остальные приходят от неё.
enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum BroadcastStatus {
  DRAFT
  RUNNING
  DONE
  STOPPED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Компания-клиент платформы. Всё остальное принадлежит организации:
/// ни один запрос к данным не выполняется без привязки к ней.
model Organization {
  id            String         @id @default(cuid())
  name          String
  hideCustomerNumbers Boolean  @default(false)
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  invites       Invite[]
  contacts      Contact[]
  conversations Conversation[]
  numbers       WhatsappNumber[]
  templates     MessageTemplate[]
  broadcasts    Broadcast[]
}

/// Рассылка по одобренному шаблону. Получатели фиксируются в момент создания,
/// чтобы отчёт не «поплыл», если контакты потом изменятся.
model Broadcast {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       MessageTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  /// Поисковый запрос, по которому отобраны получатели. Пусто — все контакты.
  segmentQuery   String?
  status         BroadcastStatus       @default(DRAFT)
  stoppedReason  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  recipients     BroadcastRecipient[]

  @@index([organizationId, createdAt])
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      RecipientStatus @default(PENDING)
  wamid       String?
  error       String?
  sentAt      DateTime?

  @@unique([broadcastId, contactId])
  @@index([wamid])
}

/// Шаблон сообщения. Пока Meta не одобрит, писать по нему клиенту нельзя.
model MessageTemplate {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  language       String
  category       TemplateCategory
  headerText     String?
  bodyText       String
  footerText     String?
  /// Примеры значений для переменных — Meta требует их при отправке на модерацию.
  examples       String[]
  status         TemplateStatus   @default(DRAFT)
  metaId         String?
  rejectedReason String?
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  broadcasts     Broadcast[]

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
}

/// Подключённый номер WhatsApp. По нему входящий вебхук находит компанию:
/// Meta присылает phone_number_id, всё остальное выводится из него.
model WhatsappNumber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumberId  String       @unique
  /// WABA — аккаунт компании в Meta. Шаблоны живут на нём, а не на номере.
  wabaId         String?
  displayNumber  String?
  qualityRating  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
}

/// Связь пользователя с организацией и его роль в ней.
/// Один человек может работать в нескольких компаниях.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Приглашение сотрудника одноразовой ссылкой — почта не нужна,
/// ссылку владелец передаёт сам.
model Invite {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  hint           String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Contact {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waId           String
  name           String?
  createdAt      DateTime       @default(now())
  conversations  Conversation[]
  broadcasts     BroadcastRecipient[]

  @@unique([organizationId, waId])
  @@index([organizationId])
}

model Conversation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumberId   String
  lastMessageAt   DateTime     @default(now())
  windowExpiresAt DateTime?
  messages        Message[]

  @@unique([contactId, phoneNumberId])
  @@index([organizationId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  wamid          String           @unique
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           String
  text           String?
  status         String?
  timestamp      DateTime
  createdAt      DateTime         @default(now())

  @@index([conversationId, timestamp])
}
