// Схема базы. Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
}

/// Категории Meta. От категории зависит цена сообщения и строгость модерации.
enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// DRAFT — наш собственный статус, до отправки в Meta. Остальные приходят от неё.
enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum BroadcastStatus {
  DRAFT
  RUNNING
  DONE
  STOPPED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

/// Компания-клиент платформы. Всё остальное принадлежит организации:
/// ни один запрос к данным не выполняется без привязки к ней.
model Organization {
  id            String         @id @default(cuid())
  name          String
  hideCustomerNumbers Boolean  @default(false)
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  invites       Invite[]
  contacts      Contact[]
  conversations Conversation[]
  numbers       WhatsappNumber[]
  templates     MessageTemplate[]
  broadcasts    Broadcast[]
  tags          Tag[]
  automation    Automation?
  aiBot         AiBot?
  aiReplies     AiReply[]
}

/// Настройки ИИ-помощника. Отвечает клиентам по анкете компании,
/// пока не подключится оператор.
model AiBot {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  /// Модель Claude. Меняется без правки кода — на случай, когда выйдет новая.
  model   String  @default("claude-opus-5")

  /// Анкета компании: чем занимаетесь, услуги, цены, часы работы.
  /// Это постоянная часть запроса, она кэшируется — менять её часто дорого.
  companyProfile String
  /// Чего боту нельзя обещать: скидки, сроки, гарантии.
  rules          String?

  /// Пакет ответов: кончился — бот замолкает, а не выставляет счёт.
  answersLimit Int @default(100)
  answersUsed  Int @default(0)

  updatedAt DateTime @updatedAt
}

/// Журнал ответов бота. Нужен и для отчёта клиенту, и для разбора,
/// когда бот сказал что-то не то.
model AiReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  question       String
  answer         String?
  /// Бот решил, что нужен человек, и передал диалог.
  handoff        Boolean      @default(false)
  handoffReason  String?
  error          String?
  inputTokens    Int          @default(0)
  cachedTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([conversationId])
}

/// Настройки автоответов. Одна запись на компанию.
model Automation {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  greetingEnabled Boolean @default(false)
  greetingText    String?

  awayEnabled Boolean @default(false)
  awayText    String?

  /// Часовой пояс компании: рабочие часы считаются по нему, а не по серверу.
  timezone String @default("Asia/Almaty")
  /// Расписание на неделю, начиная с понедельника: [{enabled, from, to}, ...]
  schedule Json

  updatedAt DateTime @updatedAt
}

/// Рассылка по одобренному шаблону. Получатели фиксируются в момент создания,
/// чтобы отчёт не «поплыл», если контакты потом изменятся.
model Broadcast {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       MessageTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  /// Поисковый запрос, по которому отобраны получатели. Пусто — все контакты.
  segmentQuery   String?
  /// Метки, по которым отобран сегмент. Пусто — без ограничения по меткам.
  segmentTagIds  String[]
  status         BroadcastStatus       @default(DRAFT)
  stoppedReason  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  recipients     BroadcastRecipient[]

  @@index([organizationId, createdAt])
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      RecipientStatus @default(PENDING)
  wamid       String?
  error       String?
  sentAt      DateTime?

  @@unique([broadcastId, contactId])
  @@index([wamid])
}

/// Шаблон сообщения. Пока Meta не одобрит, писать по нему клиенту нельзя.
model MessageTemplate {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  language       String
  category       TemplateCategory
  headerText     String?
  bodyText       String
  footerText     String?
  /// Примеры значений для переменных — Meta требует их при отправке на модерацию.
  examples       String[]
  status         TemplateStatus   @default(DRAFT)
  metaId         String?
  rejectedReason String?
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  broadcasts     Broadcast[]

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
}

/// Подключённый номер WhatsApp. По нему входящий вебхук находит компанию:
/// Meta присылает phone_number_id, всё остальное выводится из него.
model WhatsappNumber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumberId  String       @unique
  /// WABA — аккаунт компании в Meta. Шаблоны живут на нём, а не на номере.
  wabaId         String?
  displayNumber  String?
  qualityRating  String?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  assigned     Conversation[]
  sent         Message[]
}

/// Связь пользователя с организацией и его роль в ней.
/// Один человек может работать в нескольких компаниях.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Приглашение сотрудника одноразовой ссылкой — почта не нужна,
/// ссылку владелец передаёт сам.
model Invite {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  hint           String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Contact {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  waId           String
  name           String?
  /// Заметка оператора — видна команде, клиенту нет.
  note           String?
  /// Откуда пришёл контакт: написал сам, импорт, перенос истории.
  source         String?
  createdAt      DateTime             @default(now())
  conversations  Conversation[]
  broadcasts     BroadcastRecipient[]
  tags           ContactTag[]

  @@unique([organizationId, waId])
  @@index([organizationId])
}

/// Метка для сегментации: «постоянный», «брекеты», «не звонить».
model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model Conversation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumberId   String
  lastMessageAt   DateTime     @default(now())
  windowExpiresAt DateTime?
  /// Когда в этот диалог последний раз уходил автоответ вне рабочих часов.
  awayRepliedAt   DateTime?
  /// Диалог передан человеку: бот в него больше не пишет.
  handedOffAt     DateTime?
  /// Ответственный оператор. Уходит сотрудник — диалог не пропадает,
  /// а возвращается в общую очередь: onDelete: SetNull.
  assigneeId      String?
  assignee        User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt      DateTime?
  messages        Message[]

  @@unique([contactId, phoneNumberId])
  @@index([organizationId, lastMessageAt])
  @@index([assigneeId])
}

model Message {
  id             String           @id @default(cuid())
  wamid          String           @unique
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           String
  /// Для вложения здесь подпись к файлу: у Meta это то же поле сообщения.
  text           String?
  status         String?
  timestamp      DateTime
  createdAt      DateTime         @default(now())

  /// Кто отправил, если это человек. У автоответа, рассылки и ИИ-помощника
  /// автора нет — по этому же признаку они не попадают в нагрузку операторов.
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Идентификатор файла у Meta. Она удаляет медиа через 30 дней,
  /// поэтому копию храним у себя, а id оставляем для повторной попытки.
  mediaId    String?
  mimeType   String?
  /// Имя файла для документов — клиент видит в WhatsApp именно его.
  filename   String?
  mediaSize  Int?
  /// Имя нашей копии в каталоге медиа. Пусто — файл ещё не скачан.
  mediaPath  String?
  /// Почему копию получить не удалось: оператору честнее ошибка, чем тишина.
  mediaError String?
  /// Голосовое, а не приложенный музыкальный файл.
  voice      Boolean @default(false)

  @@index([conversationId, timestamp])
  @@index([authorId])
}
