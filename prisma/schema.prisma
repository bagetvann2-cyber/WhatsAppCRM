// Схема базы. Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
  SIMULATOR
}

/// Как канал подключён — от этого зависит, какой адаптер им пользуется
/// и какие шаги нужны при создании (см. src/lib/channels).
enum ChannelConnectionMethod {
  WA_EMBEDDED_SIGNUP
  WA_MANUAL
  TG_BUSINESS
  TG_OWN_BOT
  SIMULATOR
}

enum ChannelStatus {
  PENDING
  ACTIVE
  ERROR
  DISCONNECTED
}

/// Провайдер нейросети для ИИ-помощника (см. src/lib/llm).
enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
  OPENROUTER
}

enum Role {
  OWNER
  ADMIN
  OPERATOR
}

/// Категории Meta. От категории зависит цена сообщения и строгость модерации.
enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// DRAFT — наш собственный статус, до отправки в Meta. Остальные приходят от неё.
enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum BroadcastStatus {
  DRAFT
  RUNNING
  DONE
  STOPPED
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  /// Не отправляли: контакт отписался от рассылок уже после её создания.
  /// Отдельный статус, а не ошибка — иначе автостоп сочтёт это сбоем.
  SKIPPED
}

enum SubscriptionStatus {
  /// Пробный период. Начинается не с регистрации, а с первого живого сообщения.
  TRIAL
  ACTIVE
  /// Срок вышел, деньги не пришли: рассылки останавливаются, переписка — нет.
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
}

/// DRAFT собирает бот по ходу диалога, дальше решает оператор.
enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Тариф. Цены, лимиты и состав задаются данными: Meta меняет правила чаще,
/// чем мы готовы выкатывать релиз ради новой цифры.
model Plan {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  /// Цена подписки в тенге за месяц. 0 — пробный.
  monthlyPrice       Int
  /// Сколько операторов включено; каждый следующий стоит extraOperatorPrice.
  operatorsIncluded  Int      @default(3)
  extraOperatorPrice Int      @default(5000)
  numbersIncluded    Int      @default(1)
  /// Доступ к интеграциям с CRM — отличие «Бизнеса» от «Старта».
  integrations       Boolean  @default(false)
  trialDays          Int      @default(0)
  /// Ответов ИИ-помощника в месяц на нашем ключе. 0 — помощника в тарифе нет.
  aiAnswersPerMonth  Int      @default(0)
  /// Что входит — строками для карточки тарифа, без правки вёрстки.
  features           String[]
  sortOrder          Int      @default(0)
  active             Boolean  @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @unique
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan               @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIAL)
  /// Сколько месяцев оплачено разом: от этого считается скидка за период.
  periodMonths   Int                @default(1)
  trialEndsAt    DateTime?
  paidUntil      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

/// Счёт на оплату. Пока оплата не подключена, счёт создаётся и ждёт:
/// Kaspi и безналичный расчёт встают на это же место без переделки модели.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Номер для клиента: его называют в назначении платежа.
  number         String        @unique
  kind           String
  amount         Int
  description    String
  method         String
  status         InvoiceStatus @default(PENDING)
  planCode       String?
  periodMonths   Int?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/// Движение по балансу. Баланс организации — сумма операций, но хранится
/// и отдельным полем: считать историю на каждый показ страницы дорого.
model BalanceOperation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Плюс — пополнение, минус — списание.
  amount         Int
  kind           String
  description    String
  /// Списание за рассылку ссылается на неё: в отчёте видно, куда ушли деньги.
  broadcastId    String?
  balanceAfter   Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/// Компания-клиент платформы. Всё остальное принадлежит организации:
/// ни один запрос к данным не выполняется без привязки к ней.
model Organization {
  id                  String             @id @default(cuid())
  name                String
  hideCustomerNumbers Boolean            @default(false)
  /// Баланс на сообщения в тенге. Тиын не храним: в обороте его нет,
  /// а дробные копейки в биллинге — источник вечных расхождений.
  balance             Int                @default(0)
  createdAt           DateTime           @default(now())
  subscription        Subscription?
  invoices            Invoice[]
  operations          BalanceOperation[]
  memberships         Membership[]
  invites             Invite[]
  contacts            Contact[]
  conversations       Conversation[]
  channels            Channel[]
  templates           MessageTemplate[]
  broadcasts          Broadcast[]
  tags                Tag[]
  automation          Automation?
  aiBot               AiBot?
  aiReplies           AiReply[]
  aiUsage             AiUsage[]
  orderFields         OrderField[]
  orders              Order[]
}

/// Настройки ИИ-помощника. Отвечает клиентам по анкете компании,
/// пока не подключится оператор.
model AiBot {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)
  provider AiProvider @default(ANTHROPIC)
  /// null на нашем ключе означает «модель каталога по умолчанию для провайдера»: смена
  /// победителя замера не требует миграции. Id хранится только у бота на ключе клиента.
  model    String?

  /// Анкета компании: чем занимаетесь, услуги, цены, часы работы.
  /// Это постоянная часть запроса, она кэшируется — менять её часто дорого.
  companyProfile String
  /// Чего боту нельзя обещать: скидки, сроки, гарантии.
  rules          String?

  /// Пакет ответов на нашем ключе. Размер задаёт тариф (Plan.aiAnswersPerMonth), а не клиент.
  /// Кончился — бот отвечает заглушкой, а не выставляет счёт. Счётчик сбрасывается при оплате
  /// подписки и раз в месяц от answersPeriodStart (см. reserveAnswer).
  answersUsed        Int      @default(0)
  answersPeriodStart DateTime @default(now())

  /// Что уходит клиенту, когда бот не может ответить. null — текст по умолчанию.
  stubText   String?
  stubTextKz String?

  updatedAt DateTime @updatedAt
}

/// Журнал ответов бота. Нужен и для отчёта клиенту, и для разбора,
/// когда бот сказал что-то не то.
enum AiUsageKind {
  GENERATOR
  TEST
  PROBE
}

/// Вызовы модели не из переписки клиентов: генератор анкеты, тест-чат, проверка ключа.
/// Нужна для суточных лимитов и для расчёта расхода наших ключей.
model AiUsage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           AiUsageKind
  provider       AiProvider?
  model          String?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, kind, createdAt])
}

model AiReply {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  question       String
  answer         String?
  /// Бот решил, что нужен человек, и передал диалог.
  handoff        Boolean      @default(false)
  handoffReason  String?
  error          String?
  /// Код исхода (см. BotOutcome в ai-bot.ts), HTTP-статус и код ошибки провайдера. Без текста
  /// ошибки провайдера: в нём бывает кусок ключа.
  outcome        String?
  httpStatus     Int?
  providerCode   String?
  /// answer в этой записи — заглушка, а не ответ модели.
  stub           Boolean      @default(false)
  /// Кто и как отвечал: нужно и для журнала, и для расчёта расхода по провайдерам.
  provider       AiProvider?
  model          String?
  latencyMs      Int?
  inputTokens    Int          @default(0)
  cachedTokens   Int          @default(0)
  outputTokens   Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([conversationId])
}

/// Поле заказа, которое бизнес настраивает под свою нишу: риелтору нужен
/// адрес и бюджет, кафе — блюдо и время доставки. `id` служит и ключом
/// в JSON заказа, и именем свойства в tool-схеме бота (src/lib/ai-client.ts) —
/// отдельный человекочитаемый ключ не заводим, у поля и так есть `label`.
model OrderField {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  type           OrderFieldType @default(TEXT)
  /// Варианты для типа SELECT, для остальных типов null.
  options        Json?
  required       Boolean        @default(false)
  /// Порядок в настройках, в tool-схеме бота и в колонках выгрузки.
  position       Int            @default(0)
  createdAt      DateTime       @default(now())

  @@index([organizationId, position])
}

/// Заказ, который бот собрал из переписки. Один активный (DRAFT) заказ на
/// диалог — оператор подтверждает или отменяет его; следующий заказ в этом
/// же диалоге появляется только после того, как текущий закрыт.
model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         OrderStatus  @default(DRAFT)
  /// {OrderField.id: значение} — состав ключей определяется текущей схемой
  /// полей организации на момент записи.
  fields         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  confirmedAt    DateTime?

  @@index([organizationId, status, createdAt])
  @@index([conversationId, status])
}

/// Настройки автоответов. Одна запись на компанию.
model Automation {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  greetingEnabled Boolean @default(false)
  greetingText    String?

  awayEnabled Boolean @default(false)
  awayText    String?

  /// Часовой пояс компании: рабочие часы считаются по нему, а не по серверу.
  timezone String @default("Asia/Almaty")
  /// Расписание на неделю, начиная с понедельника: [{enabled, from, to}, ...]
  schedule Json

  updatedAt DateTime @updatedAt
}

/// Рассылка по одобренному шаблону. Получатели фиксируются в момент создания,
/// чтобы отчёт не «поплыл», если контакты потом изменятся.
model Broadcast {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       MessageTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name           String
  /// Поисковый запрос, по которому отобраны получатели. Пусто — все контакты.
  segmentQuery   String?
  /// Метки, по которым отобран сегмент. Пусто — без ограничения по меткам.
  segmentTagIds  String[]
  status         BroadcastStatus      @default(DRAFT)
  stoppedReason  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime             @default(now())
  recipients     BroadcastRecipient[]

  @@index([organizationId, createdAt])
}

model BroadcastRecipient {
  id          String          @id @default(cuid())
  broadcastId String
  broadcast   Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status      RecipientStatus @default(PENDING)
  wamid       String?
  error       String?
  sentAt      DateTime?

  @@unique([broadcastId, contactId])
  @@index([wamid])
}

/// Шаблон сообщения. Пока Meta не одобрит, писать по нему клиенту нельзя.
model MessageTemplate {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  language       String
  category       TemplateCategory
  headerText     String?
  bodyText       String
  footerText     String?
  /// Примеры значений для переменных — Meta требует их при отправке на модерацию.
  examples       String[]
  status         TemplateStatus   @default(DRAFT)
  metaId         String?
  rejectedReason String?
  submittedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  broadcasts     Broadcast[]

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
}

/// Подключённый канал компании: номер WhatsApp, Telegram-бот или демо-симулятор.
/// По (type, externalId) входящий вебхук находит организацию.
model Channel {
  id                   String                  @id @default(cuid())
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                 ChannelType
  connectionMethod     ChannelConnectionMethod
  name                 String
  isActive             Boolean                 @default(true)
  status               ChannelStatus           @default(PENDING)
  /// Понятный пользователю текст причины ошибки — не стектрейс.
  statusError          String?
  /// Текущий шаг долгого подключения (Embedded Signup) — для прогресса в интерфейсе.
  connectStep          String?
  /// phone_number_id (WhatsApp) / business_connection_id (Telegram Business) / id бота (свой бот).
  externalId           String?
  /// Номер телефона или @username — то, что показываем в списке каналов.
  externalUsername     String?
  /// Telegram-аккаунт владельца, привязавшего Business-канал: по нему отличаем
  /// его сообщения от сообщений клиента в одном business_connection.
  telegramUserId       String?
  /// WhatsApp: access_token, wabaId, pin. Свой бот Telegram: bot_token, webhook secret.
  /// Формат "v1:iv:tag:data" — см. src/lib/crypto.ts. В API не возвращается никогда.
  credentialsEncrypted String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  contacts      Contact[]
  conversations Conversation[]
  messages      Message[]

  /// WhatsApp пока живёт по номеру телефона: один и тот же phone_number_id
  /// не может принадлежать двум разным компаниям платформы одновременно.
  @@unique([type, externalId])
  @@index([organizationId])
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  /// Пока null — вход запрещён, см. signInAction.
  emailVerifiedAt            DateTime?
  verificationToken          String?   @unique
  verificationTokenExpiresAt DateTime?
  memberships  Membership[]
  sessions     Session[]
  assigned     Conversation[]
  sent         Message[]
}

/// Связь пользователя с организацией и его роль в ней.
/// Один человек может работать в нескольких компаниях.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Приглашение сотрудника одноразовой ссылкой — почта не нужна,
/// ссылку владелец передаёт сам.
model Invite {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  hint           String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Contact {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelId         String
  channel           Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Номер телефона (WhatsApp) или chat_id (Telegram) — в разных каналах разное
  /// адресное пространство, поэтому уникальность считается внутри канала, не организации.
  externalUserId    String
  name              String?
  /// Заметка оператора — видна команде, клиенту нет.
  note              String?
  /// Откуда пришёл контакт: написал сам, импорт, перенос истории.
  source            String?
  /// Отказ от рассылок. Служебные сообщения по-прежнему уходят: клиент
  /// отписывался от рекламы, а не от подтверждения своей записи.
  unsubscribedAt    DateTime?
  /// Как отписался: сам написал «стоп», кнопкой в рассылке или снял оператор.
  unsubscribeSource String?
  createdAt         DateTime             @default(now())
  conversations     Conversation[]
  broadcasts        BroadcastRecipient[]
  tags              ContactTag[]

  @@unique([channelId, externalUserId])
  @@index([organizationId])
}

/// Метка для сегментации: «постоянный», «брекеты», «не звонить».
model Tag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

model Conversation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastMessageAt   DateTime     @default(now())
  windowExpiresAt DateTime?
  /// Когда в этот диалог последний раз уходил автоответ вне рабочих часов.
  awayRepliedAt   DateTime?
  /// Диалог передан человеку: бот в него больше не пишет.
  handedOffAt     DateTime?
  /// Ответственный оператор. Уходит сотрудник — диалог не пропадает,
  /// а возвращается в общую очередь: onDelete: SetNull.
  assigneeId      String?
  assignee        User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt      DateTime?
  messages        Message[]
  orders          Order[]

  @@unique([contactId, channelId])
  @@index([organizationId, lastMessageAt])
  @@index([assigneeId])
  @@index([channelId])
}

model Message {
  id                String           @id @default(cuid())
  /// id сообщения у канала (wamid у WhatsApp, message_id у Telegram). У сообщений,
  /// рождённых внутри платформы (симулятор), — синтетический id платформы.
  externalMessageId String
  channelId         String
  channel           Channel          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  type              String
  /// Для вложения здесь подпись к файлу: у Meta это то же поле сообщения.
  text              String?
  status            String?
  timestamp         DateTime
  createdAt         DateTime         @default(now())

  /// Кто отправил, если это человек. У автоответа, рассылки и ИИ-помощника
  /// автора нет — по этому же признаку они не попадают в нагрузку операторов.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Идентификатор файла у Meta. Она удаляет медиа через 30 дней,
  /// поэтому копию храним у себя, а id оставляем для повторной попытки.
  mediaId    String?
  mimeType   String?
  /// Имя файла для документов — клиент видит в WhatsApp именно его.
  filename   String?
  mediaSize  Int?
  /// Имя нашей копии в каталоге медиа. Пусто — файл ещё не скачан.
  mediaPath  String?
  /// Почему копию получить не удалось: оператору честнее ошибка, чем тишина.
  mediaError String?
  /// Голосовое, а не приложенный музыкальный файл.
  voice      Boolean @default(false)

  @@unique([channelId, externalMessageId])
  @@index([conversationId, timestamp])
  @@index([authorId])
}
